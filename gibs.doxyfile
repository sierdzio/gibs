DOXYFILE_ENCODING = UTF-8

PROJECT_NAME = gibs
PROJECT_NUMBER = 0.2.0
PROJECT_BRIEF = "Generally In-source Build System"
PROJECT_LOGO = deployment/gibs.png

OUTPUT_DIRECTORY = doc/

INPUT = LICENSE.txt AUTHORS.md README.md .gitignore \
        deployment/ libraries/ src/
#EXCLUDE_PATTERNS = */something/*
USE_MDFILE_AS_MAINPAGE = ./README.md
MARKDOWN_SUPPORT = YES
TOC_INCLUDE_HEADINGS = 99

RECURSIVE = TRUE
QT_AUTOBRIEF = YES

EXTRACT_ALL = YES
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES

DISTRIBUTE_GROUP_DOC = YES

GENERATE_TAGFILE = gibs.doxytag
GENERATE_HTML = YES
GENERATE_LATEX = NO
GENERATE_RTF = NO
GENERATE_MAN = NO
GENERATE_XML = NO

HTML_OUTPUT = html/
HTML_FILE_EXTENSION = .html

TAB_SIZE = 4
INHERIT_DOCS = YES
BUILTIN_STL_SUPPORT = YES
GENERATE_TODOLIST = YES

ALLEXTERNALS = YES
EXTERNAL_GROUPS = YES
EXTERNAL_PAGES = YES

HAVE_DOT = YES
